# Flask Configuration
SECRET_KEY=smartfit-development-secret-key-change-me
FLASK_ENV=development
PORT=5001

# Database Configuration (Defaults to SQLite in instance/SmartFit.db)
# DATABASE_URL=sqlite:///instance/SmartFit.db

# Frontend Application URL (for CORS and reset email links)
FRONTEND_URL=http://localhost:8080

# Mail Configuration (Optional - for password reset)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

